{
  // Publica la app (dist/) y la API de copias en la nube (worker/index.ts).
  "name": "sdtech-imports",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare crea el espacio KV automáticamente en el primer despliegue.
  "kv_namespaces": [{ "binding": "BACKUPS" }],
  // Vistas previas por rama (npx wrangler preview). Sin BACKUPS a propósito:
  // una rama de prueba no debe leer ni escribir las copias reales de la tienda.
  "previews": {}
}
