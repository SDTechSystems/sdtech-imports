{
  // Publica la app (dist/) y la API de copias en la nube (worker/index.ts).
  "name": "sdtech-imports",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // El Worker atiende todo primero: arma la página del recibo (/verificar/*)
    // y limita lo que se abre en el dominio de recibos.
    "run_worker_first": true
  },
  // La app sigue en workers.dev. Los recibos se abren en recibos.sdtechsystems.dev,
  // un dominio personalizado conectado a este Worker desde Cloudflare
  // (Workers → sdtech-imports → Domains & Routes). No se declara aquí en "routes"
  // para que el despliegue no dependa de permisos de DNS del token de compilación.
  "workers_dev": true,
  // Cloudflare crea el espacio KV automáticamente en el primer despliegue.
  "kv_namespaces": [{ "binding": "BACKUPS" }],
  // Vistas previas por rama (npx wrangler preview). Sin BACKUPS a propósito:
  // una rama de prueba no debe leer ni escribir las copias reales de la tienda.
  "previews": {}
}
